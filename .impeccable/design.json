    }
  ],
  "narrative": {
    "northStar": "业务工作台",
    "overview": "清楚、克制、可靠，以完成任务为先。设计感来自任务顺序、对象身份、数字对齐与操作反馈：先认出正在处理的客户或订单，再理解状态和下一步。\n\n保留钴蓝、石墨、冷白的现有体系。浅色页面承载信息，细边框区分相邻区域，弹窗用集中层次承载一项任务。主操作醒目，次操作安静，输入边界清楚；统计卡保持统一浅色。",
    "keyCharacteristics": [
      "对象名称与当前任务优先，辅助说明后置。",
      "克制而明确的控件，持续可见的键盘焦点。",
      "桌面按列比较，手机按记录阅读。",
      "反馈可理解、可恢复，动态效果不承载唯一信息。"
    ],
    "rules": [
      {
        "name": "The 明确边界 Rule",
        "body": "输入控件使用 control-border，不能退化为容器的浅色分隔线。",
        "section": "colors"
      },
      {
        "name": "The 数字可比 Rule",
        "body": "金额保留币种和精度，用等宽数字对齐，不用动画数字替代实际金额。",
        "section": "typography"
      },
      {
        "name": "The 统一统计 Rule",
        "body": "统计卡保持统一浅色，不用第一张深色卡制造任意重要性。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 先展示客户/订单身份，再展示任务、时间和操作。",
      "Do 保留键盘焦点、状态文字、错误恢复和减少动态回退。",
      "Do 同时检查桌面比较和手机逐条处理的布局。"
    ],
    "donts": [
      "Don't 用深色首项统计卡破坏统一浅色统计体系。",
      "Don't 用颜色、动效或装饰性小标题替代必要的业务说明。",
      "Don't 将屏幕主题自动套用到正式报价打印文档。"
    ]
  }
}

{
  "name": "vesta-local-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && vite build",
    "start": "node dist/server/main.js",
    "test": "tsc -p tsconfig.server.json && node --test tests/*.test.mjs",
    "local": "node scripts/local.mjs",
    "demo:data": "tsc -p tsconfig.server.json && node scripts/demo-data.mjs",
    "db": "node scripts/database.mjs",
    "check": "pnpm build && pnpm test",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "17.11.0-beta.19",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
